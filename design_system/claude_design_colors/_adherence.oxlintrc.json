{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Domine|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Domine, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCardPalette'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|base|light|faint|key|ref|className|style|children)$/]",
        "message": "<SectionCardPalette> doesn't accept that prop. Declared props: dark, base, light, faint."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "SectionCardPalette": {
        "replaces": []
      }
    },
    "tokens": [
      "--body-line-height",
      "--border",
      "--border-light",
      "--border-subtle",
      "--error",
      "--error-bg",
      "--error-border",
      "--explore-base",
